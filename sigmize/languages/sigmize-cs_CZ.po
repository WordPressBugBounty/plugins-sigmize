msgstr ""
"Sledujte dokončení nákupů a příjmy na variantu. Měřte, která varianta "
"přináší více digitálních prodejů."

#: src/components/AuthPage.jsx:195
msgid "SureCart Integration"
msgstr "Integrace SureCart"

#: src/components/AuthPage.jsx:196
