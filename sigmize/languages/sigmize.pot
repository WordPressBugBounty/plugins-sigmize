msgstr ""

#: includes/class-abilities-provider.php:176
msgid "Sigmize: List Experiments"
msgstr ""

#: includes/class-abilities-provider.php:177
msgid "Returns the locally-cached list of A/B testing experiments, optionally filtered by status."
msgstr ""

#: includes/class-abilities-provider.php:185
msgid "Filter experiments by status (e.g. \"running\")."
msgstr ""

#: includes/class-abilities-provider.php:213
msgid "Sigmize: Get Experiment"
msgstr ""

#: includes/class-abilities-provider.php:214
msgid "Returns a single experiment from the local cache by its UUID."
msgstr ""

#: includes/class-abilities-provider.php:223
msgid "The UUID of the experiment to retrieve."
msgstr ""

#: includes/class-abilities-provider.php:251
msgid "Sigmize: Request Sync"
msgstr ""

#: includes/class-abilities-provider.php:252
msgid "Triggers an immediate sync that fetches all experiments from the remote Sigmize SaaS platform and overwrites the local experiment cache. Makes an outbound HTTP request to the Sigmize API. Safe to run multiple times — each run fetches the latest data. Avoid calling this repeatedly in quick succession."
msgstr ""

#: includes/class-abilities-provider.php:283
msgid "Sigmize: Cache Stats"
msgstr ""

#: includes/class-abilities-provider.php:284
msgid "Returns statistics about the local experiments cache, including count and last sync time."
msgstr ""

#: includes/class-abilities-provider.php:315
msgid "Sigmize: Get Settings"
msgstr ""

#: includes/class-abilities-provider.php:316
msgid "Returns the current Sigmize plugin settings including SDK loading mode and GDPR configuration. Call this before using update-sdk-mode to check the current state."
msgstr ""

#: includes/class-abilities-provider.php:347
msgid "Sigmize: Update SDK Mode"
msgstr ""

#: includes/class-abilities-provider.php:348
msgid "Enables or disables manual SDK loading mode for the Sigmize snippet. When enabled, the Sigmize JavaScript SDK is not automatically injected into pages — the site owner must load it manually. This directly affects whether A/B tests run on the frontend. Confirm with the user before changing, especially when disabling automatic loading, as it will stop all running experiments from functioning."
msgstr ""

#: includes/class-abilities-provider.php:357
msgid "Whether to enable manual SDK loading."
msgstr ""

#: includes/class-abilities-provider.php:385
msgid "Sigmize: Disconnect"
msgstr ""

#: includes/class-abilities-provider.php:386
msgid "Permanently disconnects the site from the Sigmize SaaS platform, deleting all authentication tokens, cached experiment data, and plugin settings. This cannot be undone — the user will need to reconnect and reconfigure from scratch. Always ask the user to explicitly confirm before running this."
msgstr ""

#: includes/class-abilities-provider.php:504
msgid "The `uuid` input parameter is required."
msgstr ""

#: includes/class-abilities-provider.php:616
msgid "The `manual_sdk_loading` input parameter is required."
msgstr ""

