{"translation-revision-date":"2026-06-03T13:20:33+00:00","generator":"WP-CLI\/2.12.0","source":"assets\/js\/a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ar","plural-forms":"nplurals=2; plural=(n != 1);"},"Sigmize":["Sigmize"],"Easy Digital Downloads":["\u062a\u0646\u0632\u064a\u0644\u0627\u062a \u0631\u0642\u0645\u064a\u0629 \u0633\u0647\u0644\u0629"],"Authentication":["\u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629"],"A\/B Testing (SaaS)":["\u0627\u062e\u062a\u0628\u0627\u0631 A\/B (SaaS)"],"Authentication failed":["\u0641\u0634\u0644\u062a \u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629"],"Please try again. If the problem persists, contact support.":["\u064a\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649. \u0625\u0630\u0627 \u0627\u0633\u062a\u0645\u0631 \u0627\u0644\u0645\u0634\u0643\u0644\u0629\u060c \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u062f\u0639\u0645."],"Welcome to Sigmize":["\u0645\u0631\u062d\u0628\u064b\u0627 \u0628\u0643 \u0641\u064a Sigmize"],"Sigmize is a comprehensive A\/B testing and analytics platform that helps you optimize your website performance through data-driven experiments. Create variations, analyze user behavior with heatmaps and session replays, and make informed decisions based on real insights.":["Sigmize \u0647\u064a \u0645\u0646\u0635\u0629 \u0634\u0627\u0645\u0644\u0629 \u0644\u0627\u062e\u062a\u0628\u0627\u0631 A\/B \u0648\u0627\u0644\u062a\u062d\u0644\u064a\u0644\u0627\u062a \u062a\u0633\u0627\u0639\u062f\u0643 \u0639\u0644\u0649 \u062a\u062d\u0633\u064a\u0646 \u0623\u062f\u0627\u0621 \u0645\u0648\u0642\u0639\u0643 \u0645\u0646 \u062e\u0644\u0627\u0644 \u062a\u062c\u0627\u0631\u0628 \u0645\u062f\u0641\u0648\u0639\u0629 \u0628\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a. \u0623\u0646\u0634\u0626 \u062a\u0646\u0648\u064a\u0639\u0627\u062a\u060c \u0648\u062d\u0644\u0644 \u0633\u0644\u0648\u0643 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0645\u0646 \u062e\u0644\u0627\u0644 \u062e\u0631\u0627\u0626\u0637 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0648\u0625\u0639\u0627\u062f\u0629 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062c\u0644\u0633\u0627\u062a\u060c \u0648\u0627\u062a\u062e\u0630 \u0642\u0631\u0627\u0631\u0627\u062a \u0645\u0633\u062a\u0646\u064a\u0631\u0629 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0631\u0624\u0649 \u062d\u0642\u064a\u0642\u064a\u0629."],"Get Started":["\u0627\u0628\u062f\u0623 \u0627\u0644\u0622\u0646"],"Analytics Dashboard Preview":["\u0645\u0639\u0627\u064a\u0646\u0629 \u0644\u0648\u062d\u0629 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062a\u062d\u0644\u064a\u0644\u0627\u062a"],"Experiment Management":["\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u0628"],"Create and manage A\/B tests with intuitive controls and comprehensive experiment tracking.":["\u0623\u0646\u0634\u0626 \u0648\u0623\u062f\u0631 \u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a A\/B \u0645\u0639 \u0623\u062f\u0648\u0627\u062a \u062a\u062d\u0643\u0645 \u0628\u062f\u064a\u0647\u064a\u0629 \u0648\u062a\u062a\u0628\u0639 \u0634\u0627\u0645\u0644 \u0644\u0644\u062a\u062c\u0627\u0631\u0628."],"Variation Testing":["\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u062a\u0646\u0648\u064a\u0639\u0627\u062a"],"Test different page variations and element changes to find the most effective designs.":["\u0627\u062e\u062a\u0628\u0631 \u062a\u0646\u0648\u064a\u0639\u0627\u062a \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0645\u062e\u062a\u0644\u0641\u0629 \u0648\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0644\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u062a\u0635\u0645\u064a\u0645\u0627\u062a \u0627\u0644\u0623\u0643\u062b\u0631 \u0641\u0627\u0639\u0644\u064a\u0629."],"Traffic Assignment":["\u062a\u0648\u0632\u064a\u0639 \u0627\u0644\u0632\u064a\u0627\u0631\u0627\u062a"],"Intelligent visitor assignment ensures balanced traffic distribution across test variants.":["\u064a\u0636\u0645\u0646 \u0627\u0644\u062a\u0648\u0632\u064a\u0639 \u0627\u0644\u0630\u0643\u064a \u0644\u0644\u0632\u0648\u0627\u0631 \u062a\u0648\u0632\u064a\u0639\u064b\u0627 \u0645\u062a\u0648\u0627\u0632\u0646\u064b\u0627 \u0644\u062d\u0631\u0643\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0639\u0628\u0631 \u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631."],"Heatmap Analytics":["\u062a\u062d\u0644\u064a\u0644\u0627\u062a \u062e\u0631\u0627\u0626\u0637 \u0627\u0644\u062d\u0631\u0627\u0631\u0629"],"Visualize user interactions with click heatmaps to understand where visitors engage most on your pages.":["\u062a\u062e\u064a\u0644 \u062a\u0641\u0627\u0639\u0644\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0639 \u062e\u0631\u0627\u0626\u0637 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0644\u0644\u0646\u0642\u0631 \u0644\u0641\u0647\u0645 \u0623\u064a\u0646 \u064a\u062a\u0641\u0627\u0639\u0644 \u0627\u0644\u0632\u0648\u0627\u0631 \u0623\u0643\u062b\u0631 \u0639\u0644\u0649 \u0635\u0641\u062d\u0627\u062a\u0643."],"Session Replays":["\u0625\u0639\u0627\u062f\u0629 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062c\u0644\u0633\u0627\u062a"],"Watch real user sessions to understand visitor behavior and identify conversion roadblocks.":["\u0634\u0627\u0647\u062f \u062c\u0644\u0633\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0641\u0639\u0644\u064a\u0629 \u0644\u0641\u0647\u0645 \u0633\u0644\u0648\u0643 \u0627\u0644\u0632\u0648\u0627\u0631 \u0648\u062a\u062d\u062f\u064a\u062f \u0639\u0642\u0628\u0627\u062a \u0627\u0644\u062a\u062d\u0648\u064a\u0644."],"Track purchase completions and revenue per variation. Measure which variant drives more digital product sales.":["\u062a\u062a\u0628\u0639 \u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0648\u0627\u0644\u0639\u0627\u0626\u062f\u0627\u062a \u0644\u0643\u0644 \u062a\u0646\u0648\u064a\u0639\u0629. \u0642\u064a\u0650\u0651\u0645 \u0623\u064a \u0645\u062a\u063a\u064a\u0631 \u064a\u062f\u0641\u0639 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0631\u0642\u0645\u064a\u0629."],"SureCart Integration":["\u062a\u0643\u0627\u0645\u0644 SureCart"],"Monitor add-to-cart and order completion events per variant. Optimize checkout flows for maximum revenue.":["\u0631\u0627\u0642\u0628 \u0623\u062d\u062f\u0627\u062b \u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0633\u0644\u0629 \u0648\u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0644\u0643\u0644 \u0645\u062a\u063a\u064a\u0631. \u0642\u0645 \u0628\u062a\u062d\u0633\u064a\u0646 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062f\u0641\u0639 \u0644\u062a\u062d\u0642\u064a\u0642 \u0623\u0642\u0635\u0649 \u0639\u0627\u0626\u062f."],"WooCommerce Integration":["\u062a\u0643\u0627\u0645\u0644 WooCommerce"],"Track cart additions and completed purchases by variation. Compare conversion rates and average order values.":["\u062a\u062a\u0628\u0639 \u0625\u0636\u0627\u0641\u0627\u062a \u0627\u0644\u0633\u0644\u0629 \u0648\u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629 \u062d\u0633\u0628 \u0627\u0644\u062a\u0646\u0648\u064a\u0639\u0629. \u0642\u0627\u0631\u0646 \u0645\u0639\u062f\u0644\u0627\u062a \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0648\u0645\u062a\u0648\u0633\u0637 \u0642\u064a\u0645 \u0627\u0644\u0637\u0644\u0628\u0627\u062a."],"Trusted by 100K Businesses":["\u0645\u0648\u062b\u0648\u0642 \u0628\u0647 \u0645\u0646 \u0642\u0650\u0628\u0644 100K \u0634\u0631\u0643\u0629"],"Back to Dashboard":["\u0627\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a"],"Something went wrong":["\u062d\u062f\u062b \u062e\u0637\u0623 \u0645\u0627"],"We're sorry, but something unexpected happened. Please try refreshing the page.":["\u0646\u062d\u0646 \u0622\u0633\u0641\u0648\u0646\u060c \u0648\u0644\u0643\u0646 \u062d\u062f\u062b \u0634\u064a\u0621 \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639. \u064a\u0631\u062c\u0649 \u0645\u062d\u0627\u0648\u0644\u0629 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0635\u0641\u062d\u0629."],"Try Again":["\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649"],"Reload Page":["\u0625\u0639\u0627\u062f\u0629 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0635\u0641\u062d\u0629"],"\ud83d\udd0d Error Details (Development Mode)":["\ud83d\udd0d \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062e\u0637\u0623 (\u0648\u0636\u0639 \u0627\u0644\u062a\u0637\u0648\u064a\u0631)"],"Error:":["\u062e\u0637\u0623:"],"Component Stack:":["\u0645\u0643\u062f\u0633 \u0627\u0644\u0645\u0643\u0648\u0646\u0627\u062a:"],"There was an error loading the %s page. Please try refreshing the page.":["\u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062a\u062d\u0645\u064a\u0644 \u0635\u0641\u062d\u0629 %s. \u064a\u0631\u062c\u0649 \u0645\u062d\u0627\u0648\u0644\u0629 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0635\u0641\u062d\u0629."],"Oops! Something went wrong":["\u0639\u0630\u0631\u064b\u0627! \u062d\u062f\u062b \u062e\u0637\u0623 \u0645\u0627"],"We encountered an error while loading the %s page. This might be a temporary issue.":["\u0644\u0642\u062f \u0648\u0627\u062c\u0647\u0646\u0627 \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062a\u062d\u0645\u064a\u0644 \u0635\u0641\u062d\u0629 %s. \u0642\u062f \u062a\u0643\u0648\u0646 \u0647\u0630\u0647 \u0645\u0634\u0643\u0644\u0629 \u0645\u0624\u0642\u062a\u0629."],"Refresh Page":["\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0635\u0641\u062d\u0629"],"Error loading %s":["\u062e\u0637\u0623 \u0641\u064a \u062a\u062d\u0645\u064a\u0644 %s"],"Unable to load %s":["\u063a\u064a\u0631 \u0642\u0627\u062f\u0631 \u0639\u0644\u0649 \u062a\u062d\u0645\u064a\u0644 %s"],"There was an error loading the %s. Please try again.":["\u0643\u0627\u0646 \u0647\u0646\u0627\u0643 \u062e\u0637\u0623 \u0641\u064a \u062a\u062d\u0645\u064a\u0644 %s. \u064a\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"Failed to load %s. Please check your connection and try again.":["\u0641\u0634\u0644 \u0641\u064a \u062a\u062d\u0645\u064a\u0644 %s. \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u062a\u0635\u0627\u0644\u0643 \u0648\u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"We're having trouble loading the %s. This could be due to a network issue or server problem.":["\u0646\u0648\u0627\u062c\u0647 \u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u062a\u062d\u0645\u064a\u0644 %s. \u0642\u062f \u064a\u0643\u0648\u0646 \u0630\u0644\u0643 \u0628\u0633\u0628\u0628 \u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u0627\u0644\u0634\u0628\u0643\u0629 \u0623\u0648 \u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u0627\u0644\u062e\u0627\u062f\u0645."],"Retry":["\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629"],"Never":["\u0623\u0628\u062f\u0627"],"Failed to fetch sync data":["\u0641\u0634\u0644 \u0641\u064a \u062c\u0644\u0628 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629"],"Failed to update setting":["\u0641\u0634\u0644 \u0641\u064a \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0625\u0639\u062f\u0627\u062f"],"Setting Updated":["\u062a\u0645 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0625\u0639\u062f\u0627\u062f"],"SDK loading setting updated":["\u062a\u0645 \u062a\u062d\u062f\u064a\u062b \u0625\u0639\u062f\u0627\u062f \u062a\u062d\u0645\u064a\u0644 SDK"],"Update Failed":["\u0641\u0634\u0644 \u0627\u0644\u062a\u062d\u062f\u064a\u062b"],"Unable to update setting":["\u063a\u064a\u0631 \u0642\u0627\u062f\u0631 \u0639\u0644\u0649 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0625\u0639\u062f\u0627\u062f"],"Syncing":["\u062c\u0627\u0631\u064d \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629"],"Requesting sync from Sigmize...":["\u062c\u0627\u0631\u064a \u0637\u0644\u0628 \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629 \u0645\u0646 Sigmize..."],"Sync failed":["\u0641\u0634\u0644\u062a \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629"],"Synced":["\u062a\u0645\u062a \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629"],"Experiments synced":["\u062a\u0645\u062a \u0645\u0632\u0627\u0645\u0646\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u0628"],"Unable to sync":["\u063a\u064a\u0631 \u0642\u0627\u062f\u0631 \u0639\u0644\u0649 \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629"],"Sync Failed":["\u0641\u0634\u0644 \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629"],"Disconnect failed":["\u0641\u0634\u0644 \u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644"],"Disconnected":["\u062a\u0645 \u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644"],"You have been disconnected.":["\u0644\u0642\u062f \u062a\u0645 \u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644."],"Disconnect Failed":["\u0641\u0634\u0644 \u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644"],"Unable to disconnect":["\u063a\u064a\u0631 \u0642\u0627\u062f\u0631 \u0639\u0644\u0649 \u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644"],"Your WordPress site is connected to Sigmize. Create and manage A\/B test experiments from your Sigmize dashboard, then sync to pull the latest experiment updates, settings, and configurations to WordPress for fast delivery to your visitors.":["\u0645\u0648\u0642\u0639 WordPress \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0645\u062a\u0635\u0644 \u0628\u0640 Sigmize. \u0623\u0646\u0634\u0626 \u0648\u0627\u062f\u0627\u0631\u0629 \u062a\u062c\u0627\u0631\u0628 \u0627\u062e\u062a\u0628\u0627\u0631 A\/B \u0645\u0646 \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u0641\u064a Sigmize\u060c \u062b\u0645 \u0642\u0645 \u0628\u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629 \u0644\u062c\u0644\u0628 \u0623\u062d\u062f\u062b \u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u0628 \u0648\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0648\u0627\u0644\u062a\u0643\u0648\u064a\u0646\u0627\u062a \u0625\u0644\u0649 WordPress \u0644\u062a\u0633\u0644\u064a\u0645 \u0633\u0631\u064a\u0639 \u0644\u0644\u0632\u0648\u0627\u0631."],"Sync error":["\u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629"],"Connection Status":["\u062d\u0627\u0644\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644"],"Active & Healthy":["\u0646\u0634\u0637 \u0648\u0635\u062d\u064a"],"Last Sync":["\u0622\u062e\u0631 \u0645\u0632\u0627\u0645\u0646\u0629"],"Never synced":["\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629 \u0623\u0628\u062f\u064b\u0627"],"Active Experiments":["\u062a\u062c\u0627\u0631\u0628 \u0646\u0634\u0637\u0629"],"Auto Load SDK":["\u062a\u062d\u0645\u064a\u0644 SDK \u062a\u0644\u0642\u0627\u0626\u064a"],"Automatically inject the Sigmize JavaScript SDK on your website. Disable this only if you want to manually add the SDK script to your theme or custom code.":["\u0642\u0645 \u0628\u0625\u062f\u0631\u0627\u062c \u0628\u0631\u0646\u0627\u0645\u062c JavaScript SDK \u0627\u0644\u062e\u0627\u0635 \u0628Sigmize \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643. \u0642\u0645 \u0628\u062a\u0639\u0637\u064a\u0644 \u0647\u0630\u0627 \u0641\u0642\u0637 \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0631\u063a\u0628 \u0641\u064a \u0625\u0636\u0627\u0641\u0629 \u0646\u0635 \u0633\u0643\u0631\u064a\u0628\u062a SDK \u064a\u062f\u0648\u064a\u064b\u0627 \u0625\u0644\u0649 \u0633\u0645\u0629 \u0645\u0648\u0642\u0639\u0643 \u0623\u0648 \u0643\u0648\u062f \u0645\u062e\u0635\u0635."],"Warning:":["\u062a\u062d\u0630\u064a\u0631:"],"Auto loading is disabled. You'll need to manually add the SDK script to your website for A\/B testing and analytics to work.":["\u062a\u0645 \u062a\u0639\u0637\u064a\u0644 \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a. \u0633\u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0636\u0627\u0641\u0629 \u0646\u0635 \u0627\u0644\u0633\u0643\u0631\u064a\u0628\u062a SDK \u064a\u062f\u0648\u064a\u064b\u0627 \u0625\u0644\u0649 \u0645\u0648\u0642\u0639\u0643 \u0644\u0643\u064a \u064a\u0639\u0645\u0644 \u0627\u062e\u062a\u0628\u0627\u0631 A\/B \u0648\u0627\u0644\u062a\u062d\u0644\u064a\u0644\u0627\u062a."],"Open Dashboard":["\u0627\u0641\u062a\u062d \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645"],"Syncing\u2026":["\u062c\u0627\u0631\u064d \u0627\u0644\u0645\u0632\u0627\u0645\u0646\u0629\u2026"],"Sync Now":["\u0645\u0632\u0627\u0645\u0646\u0629 \u0627\u0644\u0622\u0646"],"Disconnect from Sigmize?":["\u0641\u0635\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0639\u0646 Sigmize\u061f"],"This will remove authentication and cached Sigmize experiments from WordPress. You can reconnect anytime.":["\u0633\u064a\u0624\u062f\u064a \u0630\u0644\u0643 \u0625\u0644\u0649 \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0648\u062a\u062c\u0627\u0631\u0628 Sigmize \u0627\u0644\u0645\u062e\u0632\u0646\u0629 \u0645\u0624\u0642\u062a\u064b\u0627 \u0645\u0646 WordPress. \u064a\u0645\u0643\u0646\u0643 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0641\u064a \u0623\u064a \u0648\u0642\u062a."],"Cancel":["\u0625\u0644\u063a\u0627\u0621"],"Disconnecting\u2026":["\u062c\u0627\u0631\u064d \u0641\u0635\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644\u2026"],"Disconnect":["\u0641\u0635\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644"],"Close":["\u0625\u063a\u0644\u0627\u0642"],"Something went wrong. Please try again.":["\u062d\u062f\u062b \u062e\u0637\u0623. \u064a\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."]}}}